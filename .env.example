# Copy to .env.local and fill in from your Supabase project settings.

# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe to expose to the browser — it is only as safe as
# your Row Level Security policies, so apply supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only. Lets /api/reviews write while RLS blocks direct browser
# inserts. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
